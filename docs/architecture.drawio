<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="in" value="&lt;b&gt;Damaged image&lt;/b&gt;&lt;br&gt;real photo or&lt;br&gt;synthetic damage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="den" value="&lt;b&gt;1. Denoising&lt;/b&gt;&lt;br&gt;median / bilateral /&lt;br&gt;NL-means" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mask" value="&lt;b&gt;2. Damage mask detection&lt;/b&gt;&lt;br&gt;scratches: top-hat + threshold&lt;br&gt;holes: missing pixels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inp" value="&lt;b&gt;3. Inpainting&lt;/b&gt;&lt;br&gt;TELEA / Navier-Stokes&lt;br&gt;inside the mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="deb" value="&lt;b&gt;4. Deblurring&lt;/b&gt;&lt;br&gt;Wiener deconvolution&lt;br&gt;(known / estimated PSF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Restored image&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;5. Evaluation&lt;/b&gt;&lt;br&gt;with original: PSNR, SSIM&lt;br&gt;without: NIQE / BRISQUE + visual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1000" y="270" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b&gt;Synthetic damage generator&lt;/b&gt;&lt;br&gt;clean image + noise, blur,&lt;br&gt;scratches, holes (seed 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="in" target="den"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="den" target="mask"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="mask M" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="mask" target="inp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="inp" target="deb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="deb" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="out" target="eval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="damaged" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="gen" target="in"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="clean original (reference)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="gen" target="eval"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
